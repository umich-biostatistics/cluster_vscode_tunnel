#!/bin/bash

set -o errexit -o nounset -o pipefail

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Function to validate numeric input
validate_number() {
    local input="$1"
    local field="$2"
    if ! [[ "$input" =~ ^[0-9]+$ ]] || [ "$input" -eq 0 ]; then
        print_error "Invalid $field: $input. Must be a positive integer."
        return 1
    fi
    return 0
}

# Function to validate time format (HH:MM:SS or MM:SS)
validate_time() {
    local time="$1"
    if [[ "$time" =~ ^([0-9]{1,2}):([0-9]{2})$ ]] || [[ "$time" =~ ^([0-9]{1,2}):([0-9]{2}):([0-9]{2})$ ]]; then
        return 0
    else
        print_error "Invalid time format: $time. Use HH:MM:SS or MM:SS format."
        return 1
    fi
}

# Function to get script directory
get_script_dir() {
    # First try to source the config file if we're installed via the module
    local config_file
    local codetunnel_path
    codetunnel_path="$(which codetunnel 2>/dev/null || echo "")"
    if [ -n "$codetunnel_path" ]; then
        config_file="$(dirname "$codetunnel_path")/cluster_tunnel_config"
        if [ -f "$config_file" ]; then
            # shellcheck source=/dev/null
            source "$config_file"
            if [ -n "${CLUSTER_VSCODE_TUNNEL_DIR:-}" ] && [ -d "$CLUSTER_VSCODE_TUNNEL_DIR" ]; then
                echo "$CLUSTER_VSCODE_TUNNEL_DIR"
                return
            fi
        fi
    fi
    
    # Fall back to the directory where this script is located
    local source="${BASH_SOURCE[0]}"
    while [ -h "$source" ]; do
        local dir
        dir="$(cd -P "$(dirname "$source")" >/dev/null 2>&1 && pwd)"
        source="$(readlink "$source")"
        [[ $source != /* ]] && source="$dir/$source"
    done
    echo "$(cd -P "$(dirname "$source")" >/dev/null 2>&1 && pwd)"
}

# VSCode CLI update support
CLI_PLATFORM="cli-alpine-x64"
UPDATE_API="https://update.code.visualstudio.com/api/update/$CLI_PLATFORM/stable/latest"
UPDATE_CHECK_INTERVAL_DAYS=7

# Directory holding the installed `code` binary (and the update-check cache)
get_install_dir() {
    local code_path
    code_path="$(command -v code 2>/dev/null || true)"
    if [ -n "$code_path" ]; then
        dirname "$code_path"
    else
        echo "$HOME/software/vscode"
    fi
}

# Commit hash of the installed CLI, parsed from "code 1.120.0 (commit <hash>)"
get_local_commit() {
    code --version 2>/dev/null | grep --color=never -oE '[0-9a-f]{40}' | head -n 1 || true
}

# Extract a string field from the (flat) update API JSON: json_field <key> <json>
json_field() {
    grep --color=never -oE "\"$1\":\"[^\"]*\"" <<< "$2" | head -n 1 | cut -d'"' -f4 || true
}

# Print a one-line notice if a newer CLI exists. Queries the update API at most
# once every UPDATE_CHECK_INTERVAL_DAYS days; never blocks and fails silently.
check_for_update() {
    if [ -n "${CODETUNNEL_NO_UPDATE_CHECK:-}" ]; then
        return 0
    fi

    local cache latest_commit latest_version info local_commit
    cache="$(get_install_dir)/.codetunnel_update_check"

    if [ -n "$(find "$cache" -mtime "-$UPDATE_CHECK_INTERVAL_DAYS" 2>/dev/null)" ]; then
        read -r latest_commit latest_version < "$cache" || true
    else
        info="$(curl -fsS -m 3 "$UPDATE_API" 2>/dev/null)" || return 0
        latest_commit="$(json_field version "$info")"
        latest_version="$(json_field productVersion "$info")"
        if [ -z "$latest_commit" ]; then
            return 0
        fi
        echo "$latest_commit $latest_version" > "$cache" 2>/dev/null || true
    fi

    local_commit="$(get_local_commit)"
    if [ -n "$local_commit" ] && [ -n "${latest_commit:-}" ] && [ "$local_commit" != "$latest_commit" ]; then
        print_info "A newer VSCode CLI is available (${latest_version:-unknown}). Run: codetunnel --update"
        echo ""
    fi
}

# Download the latest CLI, verify its checksum, and replace the installed binary
update_cli() {
    local install_dir info url sha256 latest_commit latest_version local_commit tmpdir
    install_dir="$(get_install_dir)"

    print_info "Checking for the latest VSCode CLI..."
    if ! info="$(curl -fsS -m 10 "$UPDATE_API")"; then
        print_error "Could not reach the VSCode update service."
        exit 1
    fi
    latest_commit="$(json_field version "$info")"
    latest_version="$(json_field productVersion "$info")"
    url="$(json_field url "$info")"
    sha256="$(json_field sha256hash "$info")"
    if [ -z "$latest_commit" ] || [ -z "$url" ] || [ -z "$sha256" ]; then
        print_error "Unexpected response from the VSCode update service."
        exit 1
    fi

    local_commit="$(get_local_commit)"
    echo "  Installed: $(code --version 2>/dev/null | head -n 1 || echo unknown)"
    echo "  Latest:    $latest_version (commit $latest_commit)"
    if [ "$local_commit" = "$latest_commit" ]; then
        print_success "VSCode CLI is already up to date."
        exit 0
    fi

    # Stage inside the install dir so the final mv is an atomic same-filesystem
    # rename; this also works while a running tunnel has the old binary open.
    tmpdir="$(mktemp -d "$install_dir/.update.XXXXXX")"
    # Expand now: $tmpdir is local and out of scope by the time the trap fires
    trap "rm -rf '$tmpdir'" EXIT

    print_info "Downloading $latest_version..."
    curl -fSL -o "$tmpdir/cli.tar.gz" "$url"
    if ! echo "$sha256  $tmpdir/cli.tar.gz" | sha256sum -c --status; then
        print_error "Checksum mismatch; not updating."
        exit 1
    fi

    tar -C "$tmpdir" -xzf "$tmpdir/cli.tar.gz"
    if [ ! -f "$tmpdir/code" ]; then
        print_error "Downloaded archive did not contain a 'code' binary; not updating."
        exit 1
    fi
    chmod +x "$tmpdir/code"
    mv -f "$tmpdir/code" "$install_dir/code"

    echo "$latest_commit $latest_version" > "$install_dir/.codetunnel_update_check" 2>/dev/null || true
    print_success "Updated VSCode CLI to $latest_version."
    print_info "Running tunnel jobs keep the old version until they are resubmitted."
}

print_usage() {
    echo "Usage: codetunnel [--update]"
    echo "  (no options)  Interactively submit a VSCode tunnel job"
    echo "  --update      Update the VSCode CLI to the latest stable release"
    echo ""
    echo "Set CODETUNNEL_NO_UPDATE_CHECK=1 to disable the weekly update notice."
}

case "${1:-}" in
    --update)
        update_cli
        exit 0
        ;;
    -h|--help)
        print_usage
        exit 0
        ;;
    "")
        ;;
    *)
        print_error "Unknown option: $1"
        print_usage
        exit 1
        ;;
esac

# Check if vscode_tunnel.sh exists in the same directory
SCRIPT_DIR=$(get_script_dir)
VSCODE_SCRIPT="$SCRIPT_DIR/vscode_tunnel.sh"

if [ ! -f "$VSCODE_SCRIPT" ]; then
    print_error "vscode_tunnel.sh not found in $SCRIPT_DIR"
    print_info "Please ensure codetunnel and vscode_tunnel.sh are in the same directory."
    exit 1
fi

check_for_update

# Display banner
echo -e "${BLUE}"
echo "╔══════════════════════════════════════════════════════════════════════════════╗"
echo "║                          VSCode Tunnel Job Submitter                        ║"
echo "║                                                                              ║"
echo "║  This script will help you submit a SLURM job to start a VSCode tunnel      ║"
echo "║  on a compute node. You'll be prompted for job parameters.                  ║"
echo "╚══════════════════════════════════════════════════════════════════════════════╝"
echo -e "${NC}"

# Prompt for job parameters with defaults
echo ""
print_info "Please provide the following job parameters (press Enter for defaults):"
echo ""

# Account (required)
while true; do
    read -p "Account (required): " ACCOUNT
    if [ -n "$ACCOUNT" ]; then
        break
    else
        print_warning "Account is required. Please enter your SLURM account."
    fi
done

# Partition
read -p "Partition [debug]: " PARTITION
PARTITION=${PARTITION:-debug}

# Memory
while true; do
    read -p "Memory (GB) [14]: " MEMORY
    MEMORY=${MEMORY:-14}
    if validate_number "$MEMORY" "memory"; then
        break
    fi
done

# CPUs
while true; do
    read -p "CPUs per task [2]: " CPUS
    CPUS=${CPUS:-2}
    if validate_number "$CPUS" "CPUs"; then
        break
    fi
done

# GPUs (optional)
read -p "GPUs (optional, press Enter to skip): " GPUS

# Time
while true; do
    read -p "Time limit (HH:MM:SS) [02:00:00]: " TIME
    TIME=${TIME:-02:00:00}
    if validate_time "$TIME"; then
        break
    fi
done

# Job name
read -p "Job name [vscode_tunnel]: " JOB_NAME
JOB_NAME=${JOB_NAME:-vscode_tunnel}

# Additional SBATCH options
read -p "Additional SBATCH options (optional, space-separated): " ADDITIONAL_OPTIONS

# Additional modules to load
read -p "Additional modules to load (optional, space-separated): " ADDITIONAL_MODULES

echo ""
print_info "Job configuration summary:"
echo "  Account: $ACCOUNT"
echo "  Partition: $PARTITION"
echo "  Memory: ${MEMORY}G"
echo "  CPUs: $CPUS"
if [ -n "$GPUS" ]; then
    echo "  GPUs: $GPUS"
fi
echo "  Time: $TIME"
echo "  Job name: $JOB_NAME"
if [ -n "$ADDITIONAL_OPTIONS" ]; then
    echo "  Additional options: $ADDITIONAL_OPTIONS"
fi
if [ -n "$ADDITIONAL_MODULES" ]; then
    echo "  Additional modules: $ADDITIONAL_MODULES"
fi

echo ""
read -p "Submit job with these parameters? [Y/n]: " CONFIRM
CONFIRM=${CONFIRM:-Y}

if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
    print_info "Job submission cancelled."
    exit 0
fi

# Create logs directory if it doesn't exist
mkdir -p "$SCRIPT_DIR/logs"

# Create temporary batch script with user parameters
TEMP_SCRIPT=$(mktemp)
cat > "$TEMP_SCRIPT" << EOF
#!/bin/bash

#SBATCH --job-name=$JOB_NAME
#SBATCH --output=$SCRIPT_DIR/logs/%x-%J.out
#SBATCH --partition=$PARTITION
#SBATCH --mem=${MEMORY}G
#SBATCH --cpus-per-task=$CPUS
#SBATCH --time=$TIME
#SBATCH --account=$ACCOUNT
EOF

# Add GPU directive if specified
if [ -n "$GPUS" ]; then
    echo "#SBATCH --gres=gpu:$GPUS" >> "$TEMP_SCRIPT"
fi

# Add additional options if specified
if [ -n "$ADDITIONAL_OPTIONS" ]; then
    echo "#SBATCH $ADDITIONAL_OPTIONS" >> "$TEMP_SCRIPT"
fi

# Add the main script content (excluding the original SBATCH directives)
echo "" >> "$TEMP_SCRIPT"
cat >> "$TEMP_SCRIPT" << EOF
ml use ~/Lmod
ml vscode
EOF

# Add additional modules if specified
if [ -n "$ADDITIONAL_MODULES" ]; then
    echo "ml $ADDITIONAL_MODULES" >> "$TEMP_SCRIPT"
    echo "" >> "$TEMP_SCRIPT"
fi

cat >> "$TEMP_SCRIPT" << EOF

# Auto-accept the license terms & launch the tunnel
VSCODE_CLI_USE_FILE_KEYCHAIN=1 VSCODE_CLI_DISABLE_KEYCHAIN_ENCRYPT=1 code tunnel --accept-server-license-terms --name \$(hostname -s)
EOF

# Submit the job
print_info "Submitting job..."
if JOB_ID=$(sbatch "$TEMP_SCRIPT" 2>&1); then
    # Extract job ID from sbatch output
    JOB_ID=$(echo "$JOB_ID" | grep -oE '[0-9]+$')
    print_success "Job submitted successfully with ID: $JOB_ID"
    
    echo ""
    print_info "Job details:"
    echo "  Job ID: $JOB_ID"
    echo "  Log file: $SCRIPT_DIR/logs/${JOB_NAME}-${JOB_ID}.out"
    
    echo ""
    print_info "Useful commands:"
    echo "  Check job status: squeue -j $JOB_ID"
    echo "  Follow log file: tail -f $SCRIPT_DIR/logs/${JOB_NAME}-${JOB_ID}.out"
    echo "  Cancel job: scancel $JOB_ID"
    
    echo ""
    print_warning "Wait for the job to start, then check the log file for the tunnel URL."
    print_info "Once the tunnel is active, you can connect using VSCode on your local machine."
    print_warning "Don't forget to cancel the job when you're done!"

else
    print_error "Failed to submit job: $JOB_ID"
    rm -f "$TEMP_SCRIPT"
    exit 1
fi

# Clean up temporary script
rm -f "$TEMP_SCRIPT"

echo ""
print_success "codetunnel completed successfully!"
print_warning "Don't forget to cancel the job when you're done!
If you don't, your job will continue running in the background and continue to incur charges."
